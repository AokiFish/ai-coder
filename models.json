{
  "default": "auto",
  "models": {
    "auto":     {"model": "openrouter/free", "max_tokens": 8000},
    "nemotron": {"model": "nvidia/nemotron-3-ultra-550b-a55b:free", "max_tokens": 8000, "tool_mode": "native"}
  },
  "base_url": "https://openrouter.ai/api/v1",
  "api_key_env": "OPENROUTER_API_KEY",
  "settings": {
    "context_limit_chars": 60000,
    "keep_recent_turns": 3,
    "auto_commit": true,
    "command_timeout": 60,
    "max_steps": 25,
    "retries": 2,
    "retry_wait": 3,
    "fallback_models": ["auto"]
  }
}
